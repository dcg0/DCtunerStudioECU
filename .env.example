# DCtunerStudioECU Environment Variables
# Copy this to .env.local and fill in your values
# DO NOT COMMIT .env.local or any file with actual secrets

# Next.js
NEXT_PUBLIC_APP_NAME=DCtunerStudioECU
NEXT_PUBLIC_API_URL=http://localhost:3000

# Demo Mode (true = use mock data, false = use real adapters)
NEXT_PUBLIC_DEMO_MODE=true

# Bluetooth/Serial Adapters
# Configure which adapters are enabled
NEXT_PUBLIC_ENABLE_ELM327=true
NEXT_PUBLIC_ENABLE_SPEEDUINO=true
NEXT_PUBLIC_ENABLE_CAN=true

# Dashboard File Validation
NEXT_PUBLIC_MAX_DASHBOARD_SIZE=1048576
NEXT_PUBLIC_ALLOWED_DASHBOARD_FORMATS=.html,.json

# Feature Flags
NEXT_PUBLIC_FEATURE_CALIBRATION_TABLES=true
NEXT_PUBLIC_FEATURE_CUSTOM_DASHBOARDS=true
NEXT_PUBLIC_FEATURE_CYLINDER_CONFIG=true
